# Tyk AI Studio workshop: local settings.
# Copy to .env (./workshop up does this for you) and add your licence.
# .env is gitignored. Never commit it.

# REQUIRED. Your Tyk AI Studio Enterprise licence key.
TYK_AI_LICENSE=

# Versions (the workshop is written and verified against these).
STUDIO_IMAGE=tykio/tyk-ai-studio-ent:v2.2.2
MICROGATEWAY_IMAGE=tykio/tyk-microgateway-ent:v2.2.2

# Host ports. Change them if something else on your machine uses one.
STUDIO_PORT=8700          # Admin console, AI Portal, Chat, management API
STUDIO_GATEWAY_PORT=8701  # Gateway embedded in AI Studio
EDGE_LONDON_PORT=8711     # Edge gateway, London (namespace: uk)
EDGE_FRANKFURT_PORT=8712  # Edge gateway, Frankfurt (namespace: eu)
LLM_SIM_PORT=8720         # Simulated LLM providers (see stack/llm-sim)
MERIDIAN_API_PORT=8721    # Meridian's internal Policy & Claims API

# Generated on first ./workshop up. Leave blank.
WS_SECRET_KEY=
WS_ENCRYPTION_KEY=
WS_GRPC_TOKEN=
WS_JWT_SECRET=
WS_POSTGRES_PASSWORD=
WS_MERIDIAN_API_KEY=
WS_ADMIN_PASSWORD=
WS_USER_PASSWORD=
